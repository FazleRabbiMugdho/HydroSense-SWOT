# ==============================================================================
# Geospatial & Big Data Files (Keep git repo lightweight)
# Store large raw NetCDF, HDF5, GeoTIFF, and intermediate files locally
# ==============================================================================
data/raw/
data/processed/
data/interim/
data/downloads/

# Large scientific data binaries
*.nc
*.nc4
*.h5
*.hdf5
*.grib
*.grib2
*.tif
*.tiff

# Exceptions: keep sample/fixture files inside data/fixtures if explicitly added
!data/fixtures/
!data/fixtures/**
!**/README.md
!**/.gitkeep

