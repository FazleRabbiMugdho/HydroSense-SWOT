# ==============================================================================
# HydroSense-SWOT Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env to version control!
# ==============================================================================

# --- NASA Earthdata Credentials (Required for earthaccess / PO.DAAC / GES DISC) ---
# Register free at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_nasa_earthdata_username
EARTHDATA_PASSWORD=your_nasa_earthdata_password

# --- Local Storage Directories ---
DATA_CACHE_DIR=./data/cache
FIXTURES_DIR=./data/fixtures

# --- Operational Parameters ---
DEFAULT_TIMEZONE=Asia/Dhaka
DEBUG=False

# --- Streamlit Dashboard Configuration ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
